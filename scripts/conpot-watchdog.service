[Unit]
Description=Restart Conpot when Docker marks it unhealthy
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CONPOT_CONTAINER=conpot
Environment=HONEYPOT_COMPOSE_DIR=/opt/honeypot
ExecStart=/usr/local/sbin/conpot-watchdog.sh
NoNewPrivileges=true
PrivateTmp=true
