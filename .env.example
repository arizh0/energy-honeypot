# Contabo VPS provider credentials (used by Terraform)
CONTABO_CLIENT_ID=your_contabo_client_id
CONTABO_CLIENT_SECRET=your_contabo_client_secret
CONTABO_USERNAME=you@example.com
CONTABO_PASSWORD=your_contabo_password

# VPS access
HONEYPOT_VPS=admin@203.0.113.10
HONEYPOT_SSH_PORT=2222
HONEYPOT_SSH_KEY=~/.ssh/honeypot_ed25519

# Threat intelligence APIs (optional; used by analysis scripts)
SHODAN_API_KEY=your_shodan_api_key
GREYNOISE_API_KEY=your_greynoise_api_key

# Grafana: set a strong random password before deploying
GRAFANA_ADMIN_PASSWORD=change-me-long-random-password
